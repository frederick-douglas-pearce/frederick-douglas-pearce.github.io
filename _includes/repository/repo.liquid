{% comment %}
  One native repo card for /repositories/ (epic #54). Facts come from
  _data/repository_stats.json, written by bin/repo-stats.js; the language label
  can be corrected per repo in repo_language_overrides in
  _data/repositories.yml. Look repos up with a bracketed variable key, as
  _layouts/bib.liquid does: dot notation cannot take a variable key.

  Stars and forks show only above 1: a lone star reads as weak on a portfolio
  page (#56 leaves the threshold open; the owner chose above 1 in #123). The
  profile summary (repo_user.liquid) assumes this threshold twice, in its
  `stars == 1` count of hidden stars and in its star note's wording; change all
  three together. A repo missing from the stats file, e.g. one curated before
  the next script run, renders its name and link only.
{% endcomment %}
{% assign repo_url = include.repository | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

{% assign stats = site.data.repository_stats.repos[include.repository] %}

<article class="repo-card">
  <h3 class="repo-name">
    <a href="https://github.com/{{ include.repository | escape }}">
      {%- if show_owner -%}
        {{ include.repository | escape }}
      {%- else -%}
        {{ repo_url.last | escape }}
      {%- endif -%}
    </a>
  </h3>
  {% if stats %}
    {% assign language = site.data.repositories.repo_language_overrides[include.repository] | default: stats.language %}
    {% assign language_color = site.data.repository_stats.language_colors[language] %}
    <p class="repo-description">{{ stats.description | escape }}</p>
    {% if language or stats.stargazers_count > 1 or stats.forks_count > 1 %}
      <ul class="repo-meta">
        {% if language %}
          <li>
            {%- if language_color -%}
              <span class="repo-language-color" style="--repo-language-color: {{ language_color }}" aria-hidden="true"></span>
            {%- endif -%}
            {{ language | escape }}
          </li>
        {% endif %}
        {% if stats.stargazers_count > 1 %}
          <li>
            <i class="fa-solid fa-star" aria-hidden="true"></i> {{ stats.stargazers_count -}}
            <span class="sr-only"> stars</span>
          </li>
        {% endif %}
        {% if stats.forks_count > 1 %}
          <li>
            <i class="fa-solid fa-code-fork" aria-hidden="true"></i> {{ stats.forks_count -}}
            <span class="sr-only"> forks</span>
          </li>
        {% endif %}
      </ul>
    {% endif %}
  {% endif %}
</article>
